# Local development only — never commit real secrets.
DATABASE_URL="postgresql://swapdo:CHANGE_ME@localhost:5432/swapdo?schema=public"
APP_URL="http://localhost:3000"
# "mock" (sandbox, default) or "razorpay" (requires keys below + approved merchant account)
PAYMENT_PROVIDER="mock"
MOCK_WEBHOOK_SECRET="CHANGE_ME"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Bearer token required by /api/cron/* (expire rentals, billing cycle)
CRON_SECRET="CHANGE_ME"
# Signs short-lived rental access grants
ACCESS_GRANT_SECRET="CHANGE_ME"
# Password for admin@swapdo.dev on production deploys (required there unless DEMO_MODE=true).
SEED_PASSWORD=""
# Shows one-click demo logins in production builds. Never enable on a real deployment.
DEMO_MODE="false"
